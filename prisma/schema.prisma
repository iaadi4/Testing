datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String         @id @default(cuid())
  twitterId        String         @unique
  username         String         @unique
  name             String
  avatarUrl        String
  bio              String?
  location         String?
  website          String?
  followersCount   Int            @default(0)
  followingCount   Int            @default(0)
  isVerified       Boolean        @default(false)

  weeklyPrice      Float          @default(49.0)
  isListingActive  Boolean        @default(true)
  category         String         @default("Tech & Dev")
  defaultBannerUrl String         @default("/banner.png")
  payoutNotes      String?
  role             String         @default("CREATOR")
  removedAt        DateTime?

  sponsorships     Sponsorship[]  @relation("CreatorSponsorships")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Sponsorship {
  id             String    @id @default(cuid())
  creatorId      String
  creator        User      @relation("CreatorSponsorships", fields: [creatorId], references: [id], onDelete: Cascade)

  buyerName      String
  buyerEmail     String
  buyerTwitter   String?
  brandName      String
  brandUrl       String
  tagline        String?
  bannerImageUrl String

  durationWeeks  Int       @default(1)
  amountPaid     Float
  status         String    @default("PENDING")
  startDate      DateTime?
  endDate        DateTime?
  dodoPaymentId  String?
  dodoSessionId  String?
  approvedAt     DateTime?
  rejectedAt     DateTime?
  refundDue      Boolean   @default(false)
  clicksCount    Int       @default(0)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([dodoSessionId])
  @@index([dodoPaymentId])
  @@index([status])
}

model SiteSetting {
  id                  String   @id @default("default")
  platformFeePercent  Float    @default(0.0)
  featuredUsernames   String   @default("iaadi8")
  adminPassword       String?
  totalVisits         Int      @default(0)
  updatedAt           DateTime @updatedAt
}
