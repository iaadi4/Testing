# ==============================================================================
# twitterbanner.lol — Production Environment Variables Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/mydb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. TWITTER / X OAUTH 2.0 PKCE (https://developer.x.com/)
# ------------------------------------------------------------------------------
# In Twitter Developer Portal: Create an App -> User authentication settings
# App Type: Web App (confidential client) or Single page App (public client with PKCE)
# Callback URL: https://www.twitterbanner.lol/api/auth/twitter/callback
# Permissions: Read users, Read tweets, Offline access
TWITTER_CLIENT_ID="your_twitter_client_id"
TWITTER_CLIENT_SECRET="your_twitter_client_secret"

# 32+ character random string for signing HTTP-only session cookies
SESSION_SECRET="generate_a_random_32_char_secret_string_here"

# ------------------------------------------------------------------------------
# 3. DODO PAYMENTS (https://app.dodopayments.com/developer)
# ------------------------------------------------------------------------------
# Set to "live_mode" for real money, or "test_mode" for sandbox testing
DODO_PAYMENTS_ENVIRONMENT="live_mode"

# Your Dodo Payments Secret API Key (starts with dodo_live_... or dodo_test_...)
DODO_PAYMENTS_API_KEY="dodo_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Webhook Signing Secret (Found in Developer -> Webhooks -> Signing Secret)
# Webhook URL in Dodo Dashboard: https://www.twitterbanner.lol/api/webhooks/dodo
DODO_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# One-time Product ID configured with "Pay What You Want" / dynamic pricing
DODO_PRODUCT_ID="pdt_xxxxxxxxxxxx"

# ------------------------------------------------------------------------------
# 4. ADMIN SECURITY
# ------------------------------------------------------------------------------
ADMIN_PASSWORD="ChooseAStrongSecretPasswordHere123!"

# ------------------------------------------------------------------------------
# 5. APP DOMAIN
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://www.twitterbanner.lol"
APP_URL="https://www.twitterbanner.lol"

# ------------------------------------------------------------------------------
# 6. EMAIL (optional — Gmail SMTP, ~1-2 messages/day)
# ------------------------------------------------------------------------------
SMTP_USER="you@gmail.com"
SMTP_APP_PASSWORD="your_gmail_app_password"

# ------------------------------------------------------------------------------
# 7. SEARCH
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GSC_VERIFICATION=""
INDEXNOW_KEY="twitterbanner-indexnow-key"
